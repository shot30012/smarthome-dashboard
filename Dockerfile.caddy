# Caddy with the DuckDNS DNS plugin, needed for the DNS-01 certificate challenge
# (the public port is not 80/443, so the HTTP and TLS-ALPN challenges cannot work).
FROM caddy:2.10-builder AS builder
RUN xcaddy build --with github.com/caddy-dns/duckdns

FROM caddy:2.10-alpine
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
