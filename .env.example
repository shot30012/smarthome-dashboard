# Zum Ausprobieren ohne Geräte: DEMO=true (Passwort "demo"), sonst alles unten ausfüllen.
DEMO=false

# Dashboard-Login. Hash erzeugen mit:  python -m app.hashpw
# Den Hash in EINFACHE Anführungszeichen setzen (er enthält $-Zeichen).
DASHBOARD_PASSWORD_HASH='HIER_HASH_EINTRAGEN'
# Langer Zufallswert, z. B.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=HIER_ZUFALLSWERT_EINTRAGEN
# Nur auf false stellen, wenn du das Dashboard ohne HTTPS im Heimnetz nutzt.
COOKIE_SECURE=true

# Home Assistant: Profil > Sicherheit > "Langlebige Zugriffstokens"
HA_URL=http://homeassistant.local:8123
HA_TOKEN=HIER_TOKEN_EINTRAGEN

# Spotify: https://developer.spotify.com/dashboard -> App anlegen, Redirect-URI eintragen
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Lokal: http://127.0.0.1:8765/spotify/callback, auf dem Server: https://dashboarddy.duckdns.org/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/spotify/callback

# Nur für den Betrieb mit Docker und HTTPS (siehe DEPLOY.md)
DASHBOARD_DOMAIN=dashboarddy.duckdns.org
DUCKDNS_SUBDOMAIN=dashboarddy
DUCKDNS_TOKEN=HIER_DIREKT_AUF_DEM_SERVER_EINTRAGEN

# Weitere Chatbots im Panel: "Name|Health-URL", mehrere mit Komma getrennt
CHATBOTS=Dayline-Assistent|https://dayline.duckdns.org/health